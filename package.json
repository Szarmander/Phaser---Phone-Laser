{
  "name": "phaser",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "publish:mac": "electron-builder --mac --publish always",
    "publish:win": "electron-builder --win --publish always",
    "publish:all": "electron-builder -mw --publish always"
  },
  "repository": "https://github.com/Szarmander/Phaser---Phone-Laser",
  "build": {
    "appId": "com.szarmander.phaser",
    "productName": "Phaser",
    "asarUnpack": [
      "node_modules/cloudflared/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.jpg"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.jpg"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4"
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}
